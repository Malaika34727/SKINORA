
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function validProduct(data, productId) {
      return data.id == productId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.description is string
        && data.category is string
        && data.price is number
        && data.price >= 0
        && data.stock is int
        && data.stock >= 0
        && (data.imageUrl is string || data.image is string)
        && (!('imagePath' in data) || data.imagePath is string)
        && (!('brand' in data) || data.brand is string)
        && (!('discountPrice' in data)
          || (data.discountPrice is number
            && data.discountPrice >= 0
            && data.discountPrice <= data.price))
        && (!('status' in data) || data.status in ['active', 'inactive'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCustomerUpdate(customerId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return signedIn()
        && request.auth.uid == customerId
        && changedKeys.hasOnly(['name', 'phone', 'cart', 'updatedAt', 'cartUpdatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 120))
        && (!('phone' in request.resource.data)
          || (request.resource.data.phone is string
            && request.resource.data.phone.size() <= 30))
        && (!('cart' in request.resource.data)
          || (request.resource.data.cart is list
            && request.resource.data.cart.size() <= 50))
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt == request.time)
        && (!('cartUpdatedAt' in request.resource.data)
          || request.resource.data.cartUpdatedAt == request.time);
    }

    // CREATE ACCOUNT
    match /CREATEACCUSER/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'provider', 'createdAt', 'cart'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'provider', 'createdAt', 'cart'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider == 'password'
        && request.resource.data.createdAt == request.time
        && request.resource.data.cart is list;

      allow get: if signedIn() && request.auth.uid == userId;
      allow update: if validCustomerUpdate(userId);
      allow list, delete: if false;
    }

    // LOGIN RECORDS
    match /LOGINUSER/{loginId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'provider', 'loggedInAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'provider', 'loggedInAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider == 'password'
        && request.resource.data.loggedInAt == request.time;

      allow read, update, delete: if false;
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && validProduct(request.resource.data, productId);
      allow update: if isAdmin()
        && validProduct(request.resource.data, productId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ADMINS
    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // CUSTOMERS
    match /customers/{customerId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == customerId);
      allow write: if false;
      allow update: if isAdmin() || validCustomerUpdate(customerId);
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.id == categoryId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.imageUrl is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.imageUrl is string
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow get: if isAdmin() || settingId == 'storeSettings';
      allow list: if isAdmin();

      allow create, update: if isAdmin()
        && settingId == 'storeSettings'
        && request.resource.data.deliveryCharges is number
        && request.resource.data.deliveryCharges >= 0
        && request.resource.data.freeShippingThreshold is number
        && request.resource.data.freeShippingThreshold >= 0
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // MESSAGES
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'name', 'email', 'subject', 'message', 'createdAt'
        ])
        && request.resource.data.id == messageId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 2
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 2
        && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['Unread', 'Read', 'Pending']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // DENY EVERYTHING ELSE
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
